<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude
            domain="database"
            path="finance.db" />
        <exclude
            domain="database"
            path="finance.db-shm" />
        <exclude
            domain="database"
            path="finance.db-wal" />
        <exclude
            domain="file"
            path="reports/" />
    <exclude domain="file" path="guest-transfer.json" />
        <exclude domain="file" path="guest-transfer.json.bak" />
        <exclude domain="file" path="guest-transfer.json.new" />
        <exclude domain="sharedpref" path="finance_session.xml" />
    </cloud-backup>

    <device-transfer>
        <exclude
            domain="database"
            path="finance.db" />
        <exclude
            domain="database"
            path="finance.db-shm" />
        <exclude
            domain="database"
            path="finance.db-wal" />
        <exclude
            domain="file"
            path="reports/" />
    <exclude domain="file" path="guest-transfer.json" />
        <exclude domain="file" path="guest-transfer.json.bak" />
        <exclude domain="file" path="guest-transfer.json.new" />
        <exclude domain="sharedpref" path="finance_session.xml" />
    </device-transfer>
</data-extraction-rules>
